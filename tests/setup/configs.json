[
  {
    "name": "01_vendor_create_success",
    "description": "Create a new vendor successfully",
    "config": {
      "parameters": {
        "connection": {
          "tenant_id": "9b85ee6f-4fb0-4a46-8cb7-4dcc6b262a89",
          "environment": "Production",
          "company_id": "7ebcd376-7a01-f111-a1fa-6045bdfd931c"
        },
        "endpoint": "vendors",
        "write_mode": "create",
        "field_mapping": [
          {"source_column": "Name", "destination_field": "displayName"},
          {"source_column": "Email", "destination_field": "email"}
        ]
      },
      "authorization": {
        "oauth_api": {
          "credentials": {
            "appKey": "DUMMY_CLIENT_ID",
            "#appSecret": "DUMMY_CLIENT_SECRET",
            "#data": "{\"access_token\": \"DUMMY_ACCESS_TOKEN\", \"refresh_token\": \"DUMMY_REFRESH_TOKEN\"}"
          }
        }
      },
      "storage": {
        "input": {
          "tables": [
            {"destination": "vendors_create.csv"}
          ]
        }
      }
    }
  },
